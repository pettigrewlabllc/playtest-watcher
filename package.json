{
  "name": "playtest-watcher",
  "version": "0.3.0",
  "description": "Persona testers built from real players' data, run against your web game by an AI player held to their limits. CLI and local MCP server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pettigrewlabllc/playtest-watcher.git"
  },
  "bin": {
    "informed-personas": "dist/src/kit/cli.js",
    "informed-personas-mcp": "dist/src/kit/mcp.js"
  },
  "files": [
    "dist",
    "examples",
    "SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server/main.ts",
    "test": "vitest run",
    "watch": "node src/watch/run.ts",
    "predict": "node src/predict/run.ts",
    "forget": "node src/predict/forget.ts",
    "demo": "node scripts/demo.ts",
    "blur": "node scripts/blur-faces.ts",
    "play": "node src/agent/play.ts",
    "export-results": "node scripts/export-results.ts",
    "norms-doc": "node scripts/norms-doc.ts",
    "persona": "node src/kit/cli.ts",
    "mcp": "node src/kit/mcp.ts",
    "build": "node scripts/build-package.ts",
    "prepare": "node scripts/build-package.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/genai": "^2.32.0",
    "@meta-sam/parser": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "playwright": "^1.56.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
