# Copy to .env.local (git ignores it) and fill in. Live calls also need PW_LIVE=1 on the command line.
# One model key is enough. Meta's runs everything; Anthropic or Gemini build and run personas (watching a
# recording needs Meta). With several set, Meta wins unless PW_PROVIDER says otherwise.
MODEL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# PW_PROVIDER=anthropic        # meta, anthropic or gemini
# PW_MODEL=claude-sonnet-5-5   # default claude-opus-5-5 or gemini-3-flash-preview; another model needs PW_PRICE_IN/PW_PRICE_OUT
# Stop all live calls once recordings/spend.jsonl adds up to this many dollars.
PW_BUDGET_USD=120
